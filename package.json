{
  "name": "organiz",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/valentincre/organiz.git"
  },
  "engines": {
    "node": ">=26"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emu": "VITE_USE_EMULATOR=true vite",
    "build": "tsc -b && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:emulator": "firebase emulators:exec --only firestore --project demo-organiz \"vitest run --project emulator\"",
    "emulators": "firebase emulators:start --only firestore --project demo-organiz",
    "deploy": "npm run build && node scripts/deploy.mjs"
  },
  "dependencies": {
    "firebase": "^13.2.0",
    "lucide-react": "^1.68.0",
    "papaparse": "^5.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "firebase-tools": "^15.35.0",
    "oxlint": "^1.91.0",
    "playwright": "^1.64.1",
    "semantic-release": "^25.0.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
