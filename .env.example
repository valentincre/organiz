# Firebase web app config (Project settings → Your apps). Public by design:
# access is enforced by firestore.rules and the data is encrypted in the browser.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
# Public origin of the site, without a trailing slash (canonical URLs, sitemap, robots.txt).
VITE_SITE_URL=https://your-project.web.app
# Optional: where users get the source code (AGPL-3.0 section 13). Defaults to the upstream repository.
VITE_SOURCE_URL=
# Optional: Firebase Hosting site id, when not the project's default site.
FIREBASE_HOSTING_SITE=
